@import "../preference/preference.wxss";

.field-row {
  height: 104rpx;
  margin-bottom: 18rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  background: #F8F6F2;
  display: flex;
  align-items: center;
}

.field-label {
  width: 120rpx;
  color: #1F1F24;
  font-size: 28rpx;
  font-weight: 800;
}

.field-input {
  flex: 1;
  height: 100%;
  color: #1F1F24;
  font-size: 30rpx;
}

.unit {
  color: #9B9BA8;
  font-size: 24rpx;
}

.body-grid {
  display: flex;
  flex-wrap: wrap;
}

.body-chip {
  width: 30%;
  margin: 0 3.3% 18rpx 0;
  height: 76rpx;
  border-radius: 24rpx;
  background: #F0EDE8;
  color: #6B6B78;
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.body-chip.active {
  background: #E8B7C8;
  color: #1F1F24;
}

.tip-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #FBF0F4, #F5EEF8);
}

.tip-title {
  display: block;
  color: #1F1F24;
  font-size: 27rpx;
  font-weight: 800;
}

.tip-text {
  display: block;
  margin-top: 8rpx;
  color: #6B6B78;
  font-size: 24rpx;
  line-height: 1.65;
}

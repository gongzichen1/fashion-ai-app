.camera-page {
  min-height: 100vh;
  padding: 22rpx 32rpx 170rpx;
  background: #111116;
  color: #FFFFFF;
}

.camera-top,
.camera-actions,
.preview-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.camera-top {
  height: 78rpx;
}

.top-btn,
.tool-btn {
  width: 130rpx;
  height: 58rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.88);
  font-size: 24rpx;
}

.camera-title {
  flex: 1;
  text-align: center;
}

.title-text {
  display: block;
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 800;
}

.title-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #E8B7C8;
}

.camera-shell {
  height: calc(100vh - 320rpx);
  min-height: 760rpx;
  margin-top: 18rpx;
  border-radius: 46rpx;
  overflow: hidden;
  background: #000000;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.35);
}

.camera {
  width: 100%;
  height: 100%;
}

.guide-overlay,
.preview-container {
  width: 100%;
  height: 100%;
}

.guide-frame {
  position: absolute;
  left: 72rpx;
  right: 72rpx;
  top: 210rpx;
  bottom: 210rpx;
}

.corner {
  position: absolute;
  width: 70rpx;
  height: 70rpx;
  border-color: #E8B7C8;
}

.corner-tl {
  left: 0;
  top: 0;
  border-left: 8rpx solid #E8B7C8;
  border-top: 8rpx solid #E8B7C8;
}

.corner-tr {
  right: 0;
  top: 0;
  border-right: 8rpx solid #E8B7C8;
  border-top: 8rpx solid #E8B7C8;
}

.corner-bl {
  left: 0;
  bottom: 0;
  border-left: 8rpx solid #E8B7C8;
  border-bottom: 8rpx solid #E8B7C8;
}

.corner-br {
  right: 0;
  bottom: 0;
  border-right: 8rpx solid #E8B7C8;
  border-bottom: 8rpx solid #E8B7C8;
}

.guide-text {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 160rpx;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
}

.guide-tip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 116rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 22rpx;
  text-align: center;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.camera-actions {
  margin-top: 34rpx;
}

.small-action {
  width: 132rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
}

.small-icon {
  width: 36rpx;
  height: 36rpx;
  margin-bottom: 8rpx;
}

.shutter-btn {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  border: 8rpx solid rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
}

.shutter-inner {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #E8B7C8;
  box-shadow: 0 0 0 8rpx rgba(232, 183, 200, 0.22);
}

.preview-actions {
  margin-top: 34rpx;
}

.preview-btn {
  width: 48%;
  height: 88rpx;
  border-radius: 28rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.preview-btn.ghost {
  background: rgba(255, 255, 255, 0.12);
  color: #FFFFFF;
}

.preview-btn.primary {
  background: linear-gradient(135deg, #E8B7C8, #D9A5BB);
  color: #1F1F24;
}

.bottom-guide {
  margin-top: 24rpx;
  padding: 0 22rpx;
  text-align: center;
  color: rgba(255, 255, 255, 0.48);
  font-size: 22rpx;
  line-height: 1.55;
}

.analyzing-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(17, 17, 22, 0.82);
}

.analyzing-panel {
  position: relative;
  width: 520rpx;
  min-height: 420rpx;
  padding: 70rpx 46rpx 48rpx;
  border-radius: 42rpx;
  background: rgba(255, 255, 255, 0.96);
  color: #1F1F24;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
}

.scan-line {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 8rpx;
  background: linear-gradient(90deg, transparent, #E8B7C8, transparent);
  animation: scan 1.4s linear infinite;
}

@keyframes scan {
  0% { transform: translateY(0); }
  100% { transform: translateY(420rpx); }
}

.analyzing-title {
  margin-top: 26rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.analyzing-text {
  margin-top: 14rpx;
  color: #6B6B78;
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
}

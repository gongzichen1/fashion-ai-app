# 环境变量配置文件
# 复制此文件为 .env 并填入实际值

# OpenAI兼容大模型配置（必填，未配置时会使用默认演示结果）
AI_API_URL=https://your-provider.example.com/api
AI_API_KEY=your_api_key_here
AI_MODEL=your_model_name_here
AI_TIMEOUT=60

# 服务配置
HOST=0.0.0.0
PORT=5001
DEBUG=True
CORS_ORIGINS=*

# 存储配置（可选）
UPLOAD_FOLDER=
DATA_DIR=

# 密钥
SECRET_KEY=your_secret_key_here

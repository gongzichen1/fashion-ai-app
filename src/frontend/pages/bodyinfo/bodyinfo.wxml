<view class="page">
  <view class="form-card">
    <view class="field">
      <text class="label">身高 cm</text>
      <input class="input" type="number" value="{{height}}" data-field="height" bindinput="onInput" placeholder="请输入身高" />
    </view>
    <view class="field">
      <text class="label">体重 kg</text>
      <input class="input" type="digit" value="{{weight}}" data-field="weight" bindinput="onInput" placeholder="请输入体重" />
    </view>
    <view class="field">
      <text class="label">身材类型</text>
      <view class="tag-list">
        <view
          class="tag {{item.selected ? 'active' : ''}}"
          wx:for="{{bodyTypeOptions}}"
          wx:key="name"
          bindtap="chooseBodyType"
          data-value="{{item.name}}"
        >{{item.name}}</view>
      </view>
    </view>
  </view>

  <button class="save-btn" bindtap="saveBodyInfo">保存身材信息</button>
</view>

<!--pages/result/result.wxml - 搭配推荐结果页-->
<view class="result-page">
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">AI正在整理搭配结果</text>
  </view>

  <block wx:elif="{{analysisResult}}">
    <view class="top-bar">
      <view class="back-btn" bindtap="goHome">
        <text class="back-icon">‹</text>
        <text>返回</text>
      </view>
      <text class="page-title">AI分析结果</text>
      <view class="top-spacer"></view>
    </view>

    <view class="hero-card" bindtap="previewImage" data-url="{{analysisResult.image}}">
      <image class="hero-image" src="{{analysisResult.image}}" mode="aspectFill"></image>
      <view class="score-badge">
        <text class="score-star">✦</text>
        <text>搭配指数 {{analysisResult.score || 92}}</text>
      </view>
    </view>

    <view class="analysis-card">
      <view class="card-title-row">
        <view class="title-mark">✦</view>
        <text class="card-title">AI识别结果</text>
      </view>
      <view class="attr-grid">
        <view class="attr-item">
          <text class="attr-label">服装类型</text>
          <text class="attr-value">{{analysisResult.garmentType || 'AI分析结果'}}</text>
        </view>
        <view class="attr-item">
          <text class="attr-label">主色调</text>
          <text class="attr-value">{{analysisResult.colorName || analysisResult.primaryColor || '自然色系'}}</text>
        </view>
        <view class="attr-item">
          <text class="attr-label">服装分类</text>
          <text class="attr-value">{{analysisResult.category || '日常单品'}}</text>
        </view>
        <view class="attr-item">
          <text class="attr-label">适合场合</text>
          <text class="attr-value">{{analysisResult.scenesText}}</text>
        </view>
      </view>
      <view class="tag-row" wx:if="{{analysisResult.styles && analysisResult.styles.length}}">
        <text class="style-tag" wx:for="{{analysisResult.styles}}" wx:key="*this">{{item}}</text>
      </view>
      <text class="analysis-desc" wx:if="{{analysisResult.description}}">{{analysisResult.description}}</text>
    </view>

    <view class="color-card">
      <view class="card-title-row compact">
        <text class="palette-icon">●</text>
        <text class="card-title small">色彩分析</text>
      </view>
      <view class="palette-row">
        <view class="color-dot main-color" style="background: {{analysisResult.displayColor}};"></view>
        <view class="color-dot color-a"></view>
        <view class="color-dot color-b"></view>
        <view class="color-dot color-c"></view>
        <view class="color-dot color-d"></view>
      </view>
      <text class="palette-name">{{analysisResult.colorName || analysisResult.primaryColor || '柔和中性色'}}</text>
    </view>

    <view class="scene-section">
      <text class="section-title">场景搭配</text>
      <scroll-view class="scene-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="scene-list">
          <view
            class="scene-pill {{selectedScene === item.key ? 'active' : ''}}"
            wx:for="{{scenes}}"
            wx:key="key"
            bindtap="switchScene"
            data-scene="{{item.key}}"
          >
            {{item.name}}
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="recommend-section">
      <view class="section-header">
        <text class="section-title">推荐搭配单品</text>
        <text class="section-count">{{recommendations.length}} 件</text>
      </view>

      <scroll-view class="recommend-scroll" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{recommendations.length > 0}}">
        <view class="recommend-list">
          <view class="recommend-card" wx:for="{{recommendations}}" wx:key="id" bindtap="goToProduct" data-url="{{item.url}}">
            <image class="recommend-image" src="{{item.image}}" mode="aspectFill"></image>
            <view class="recommend-content">
              <text class="recommend-type">{{item.type || item.category || '搭配单品'}}</text>
              <text class="recommend-name">{{item.name}}</text>
              <text class="recommend-desc">{{item.description || item.color || '适配当前风格'}}</text>
              <text class="recommend-price">{{item.price || '查看详情'}}</text>
            </view>
          </view>
        </view>
      </scroll-view>

      <view class="empty-recommend" wx:else>
        <text>当前场景暂无推荐，切换其他场景试试</text>
      </view>
    </view>

    <view class="suggestion-card" wx:if="{{analysisResult.styleTips}}">
      <view class="title-mark">✦</view>
      <view class="suggestion-content">
        <text class="suggestion-title">智搭建议</text>
        <text class="suggestion-text">{{analysisResult.styleTips}}</text>
      </view>
    </view>

    <view class="action-grid">
      <view class="action-item {{collectStatus ? 'active' : ''}}" bindtap="toggleCollect">
        <image class="action-icon" src="{{collectStatus ? '/images/icon-collect-active.svg' : '/images/icon-collect.svg'}}"></image>
        <text>{{collectStatus ? '已收藏' : '收藏'}}</text>
      </view>
      <button class="action-item share-btn" open-type="share">
        <image class="action-icon" src="/images/icon-share.svg"></image>
        <text>分享</text>
      </button>
      <view class="action-item" bindtap="saveImage">
        <image class="action-icon" src="/images/icon-save.svg"></image>
        <text>保存</text>
      </view>
      <view class="action-item" bindtap="retake">
        <image class="action-icon" src="/images/icon-camera.svg"></image>
        <text>重新拍</text>
      </view>
    </view>

    <view class="home-action" bindtap="goHome">
      <text>返回首页</text>
    </view>
  </block>
</view>

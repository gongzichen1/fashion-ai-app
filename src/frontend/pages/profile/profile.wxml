<!--pages/profile/profile.wxml - 个人中心模板-->
<view class="profile-page">
  <view class="profile-hero">
    <view class="user-row" wx:if="{{hasUserInfo}}" bindtap="getUserProfile">
      <view class="avatar-wrap">
        <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
        <view class="online-dot"></view>
      </view>
      <view class="user-copy">
        <view class="name-row">
          <text class="nickname">{{userInfo.nickName}}</text>
          <text class="member-badge">会员</text>
        </view>
        <text class="user-tip">点击编辑头像昵称</text>
      </view>
      <view class="settings-dot">✦</view>
    </view>

    <button class="login-card" wx:else bindtap="getUserProfile">
      <view class="avatar-wrap">
        <image class="avatar" src="/images/avatar-default.svg"></image>
        <view class="online-dot"></view>
      </view>
      <view class="user-copy">
        <view class="name-row">
          <text class="nickname">登录后同步穿搭档案</text>
          <text class="member-badge">智搭</text>
        </view>
        <text class="user-tip">点击授权头像昵称</text>
      </view>
    </button>

    <view class="stats-grid">
      <view class="stat-card" bindtap="switchToStat" data-tab="history">
        <text class="stat-num">{{historyList.length}}</text>
        <text class="stat-label">分析记录</text>
      </view>
      <view class="stat-card" bindtap="switchToStat" data-tab="collect">
        <text class="stat-num">{{collectList.length || 0}}</text>
        <text class="stat-label">收藏搭配</text>
      </view>
      <view class="stat-card" bindtap="switchToStat" data-tab="wardrobe">
        <text class="stat-num">{{wardrobeList.length || 0}}</text>
        <text class="stat-label">衣橱单品</text>
      </view>
    </view>
  </view>

  <view class="tabs-shell">
    <view class="tab-item {{currentTab === 'history' ? 'active' : ''}}" bindtap="switchTab" data-tab="history">历史记录</view>
    <view class="tab-item {{currentTab === 'collect' ? 'active' : ''}}" bindtap="switchTab" data-tab="collect">我的收藏</view>
    <view class="tab-item {{currentTab === 'wardrobe' ? 'active' : ''}}" bindtap="switchTab" data-tab="wardrobe">我的衣橱</view>
  </view>

  <view class="content-panel">
    <view wx:if="{{currentTab === 'history'}}">
      <view class="history-list" wx:if="{{historyList.length > 0}}">
        <view class="history-card" wx:for="{{historyList}}" wx:key="id">
          <view class="history-main" bindtap="viewHistory" data-id="{{item.id}}">
            <image class="history-image" src="{{item.image}}" mode="aspectFill"></image>
            <view class="history-copy">
              <text class="history-title">{{item.garmentType || 'AI分析结果'}}</text>
              <text class="history-time">{{item.displayTime || '最近分析'}}</text>
              <view class="mini-tags" wx:if="{{item.styles && item.styles.length}}">
                <text class="mini-tag" wx:for="{{item.styles}}" wx:key="*this">{{item}}</text>
              </view>
            </view>
            <text class="chevron">›</text>
          </view>
          <view class="delete-btn" catchtap="deleteHistory" data-id="{{item.id}}" data-index="{{index}}">
            <image class="delete-icon" src="/images/icon-delete.svg"></image>
          </view>
        </view>
        <view class="clear-link" bindtap="clearHistory">清空历史记录</view>
      </view>

      <view class="empty-state" wx:else>
        <image class="empty-icon" src="/images/empty.svg"></image>
        <text class="empty-text">暂无历史记录</text>
        <text class="empty-tip">拍一件衣服，生成第一套 AI 搭配</text>
        <button class="empty-btn" bindtap="goToCamera">去拍照</button>
      </view>
    </view>

    <view wx:if="{{currentTab === 'collect'}}">
      <view class="collect-grid" wx:if="{{collectList.length > 0}}">
        <view class="collect-card" wx:for="{{collectList}}" wx:key="id" bindtap="viewCollect" data-id="{{item.id}}">
          <image class="collect-image" src="{{item.image}}" mode="aspectFill"></image>
          <view class="collect-mask"></view>
          <view class="collect-copy">
            <text class="collect-title">{{item.garmentType || '收藏搭配'}}</text>
            <text class="collect-time">{{item.displayTime || '已收藏'}}</text>
          </view>
          <image class="heart-icon" src="/images/icon-collect-active.svg"></image>
        </view>
      </view>

      <view class="empty-state" wx:else>
        <image class="empty-icon" src="/images/empty.svg"></image>
        <text class="empty-text">暂无收藏</text>
        <text class="empty-tip">喜欢的搭配可以收藏起来</text>
      </view>
    </view>

    <view wx:if="{{currentTab === 'wardrobe'}}">
      <view class="wardrobe-grid" wx:if="{{wardrobeList.length > 0}}">
        <view class="wardrobe-card" wx:for="{{wardrobeList}}" wx:key="id" bindtap="viewWardrobeItem" data-result-id="{{item.resultId}}">
          <image class="wardrobe-image" src="{{item.image}}" mode="aspectFill"></image>
          <view class="wardrobe-copy">
            <text class="wardrobe-name">{{item.name}}</text>
            <text class="wardrobe-type">{{item.type}}</text>
          </view>
        </view>
      </view>

      <view class="empty-state" wx:else>
        <image class="empty-icon" src="/images/empty.svg"></image>
        <text class="empty-text">暂无衣橱单品</text>
        <text class="empty-tip">完成一次 AI 分析后会自动加入衣橱</text>
        <button class="empty-btn" bindtap="goToCamera">去拍照</button>
      </view>
    </view>
  </view>

  <view class="menu-card">
    <view class="menu-item" wx:for="{{menuList}}" wx:key="title" bindtap="onMenuTap" data-path="{{item.path}}">
      <view class="menu-left">
        <view class="menu-icon-wrap">
          <image class="menu-icon" src="{{item.icon}}"></image>
        </view>
        <view>
          <text class="menu-title">{{item.title}}</text>
          <text class="menu-desc">{{item.desc}}</text>
        </view>
      </view>
      <view class="menu-right">
        <text class="menu-badge" wx:if="{{item.badge}}">{{item.badge}}</text>
        <image class="menu-arrow" src="/images/icon-arrow.svg"></image>
      </view>
    </view>
  </view>

  <view class="setting-card">
    <view class="setting-item" bindtap="clearCache">
      <text>清除缓存</text>
      <text class="setting-value">本地记录</text>
    </view>
    <view class="setting-item">
      <text>当前版本</text>
      <text class="setting-value">v1.0.0</text>
    </view>
  </view>
</view>

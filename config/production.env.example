# 仅作变量清单，不要在此文件填写或提交真实密钥。
FLASK_ENV=production
DEBUG=False
PORT=5001
SECRET_KEY=<至少32字符随机值>

DATABASE_URL=mysql+pymysql://<user>:<url-encoded-password>@<host>:3306/<database>?charset=utf8mb4

STORAGE_BACKEND=cos
COS_SECRET_ID=<通过CloudBase密钥配置注入>
COS_SECRET_KEY=<通过CloudBase密钥配置注入>
COS_REGION=ap-shanghai
COS_BUCKET=<私有桶完整名称>

FEISHU_APP_ID=cli_<app-id>
FEISHU_APP_SECRET=<通过CloudBase密钥配置注入>
FEISHU_WEB_ORIGINS=https://<同源业务域名>
FEISHU_DEV_LOGIN_ENABLED=False

AI_API_URL=https://<openai-compatible-provider>/v1
AI_API_KEY=<通过CloudBase密钥配置注入>
AI_MODEL=<支持视觉输入的模型>
AI_DEMO_MODE=False

CORS_ORIGINS=https://<同源业务域名>
IMAGE_RETENTION_DAYS=30

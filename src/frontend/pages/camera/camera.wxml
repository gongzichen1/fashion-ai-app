<!--pages/camera/camera.wxml - 拍照页模板-->
<view class="camera-page">
  <view class="camera-top">
    <view class="top-btn" bindtap="goHome">‹ 首页</view>
    <view class="camera-title">
      <text class="title-text">拍照识衣</text>
      <text class="title-sub" wx:if="{{selectedStyle}}">{{selectedStyle.name}}</text>
    </view>
    <view class="tool-btn" bindtap="toggleFlash">{{flash === 'off' ? '闪光' : flash}}</view>
  </view>

  <view class="camera-shell">
    <camera
      class="camera"
      device-position="{{devicePosition}}"
      flash="{{flash}}"
      binderror="onError"
    >
      <cover-view class="guide-overlay" wx:if="{{showGuide && !previewImage}}">
        <cover-view class="guide-frame">
          <cover-view class="corner corner-tl"></cover-view>
          <cover-view class="corner corner-tr"></cover-view>
          <cover-view class="corner corner-bl"></cover-view>
          <cover-view class="corner corner-br"></cover-view>
        </cover-view>
        <cover-view class="guide-text">请将服装完整放入取景框</cover-view>
        <cover-view class="guide-tip">保持光线充足，单品边缘尽量清晰</cover-view>
      </cover-view>

      <cover-view class="preview-container" wx:if="{{previewImage}}">
        <cover-image class="preview-image" src="{{previewImage}}"></cover-image>
      </cover-view>
    </camera>
  </view>

  <view class="camera-actions" wx:if="{{!previewImage}}">
    <view class="small-action" bindtap="chooseFromAlbum">
      <image class="small-icon" src="/images/icon-album.svg"></image>
      <text>相册</text>
    </view>
    <view class="shutter-btn" bindtap="takePhoto">
      <view class="shutter-inner"></view>
    </view>
    <view class="small-action" bindtap="switchCamera">
      <image class="small-icon" src="/images/icon-switch.svg"></image>
      <text>翻转</text>
    </view>
  </view>

  <view class="preview-actions" wx:else>
    <button class="preview-btn ghost" bindtap="retake">重新拍摄</button>
    <button class="preview-btn primary" bindtap="confirmAndAnalyze" loading="{{analyzing}}">
      {{analyzing ? '分析中...' : '开始分析'}}
    </button>
  </view>

  <view class="bottom-guide" wx:if="{{!previewImage}}">
    <text>拍摄单件衣服或完整穿搭，AI 会识别颜色、风格和适配场景</text>
  </view>

  <view class="analyzing-mask" wx:if="{{analyzing}}">
    <view class="analyzing-panel">
      <view class="scan-line"></view>
      <view class="loading-spinner"></view>
      <text class="analyzing-title">AI正在分析</text>
      <text class="analyzing-text">识别服装类型、颜色、风格与搭配场景</text>
    </view>
  </view>
</view>

.home-page {
  min-height: 100vh;
  padding: 28rpx 40rpx 56rpx;
  background: #F8F6F2;
}

.home-header {
  padding-bottom: 12rpx;
}

.brand-row,
.header-main,
.location-row,
.weather-top,
.weather-stats,
.album-cta,
.section-header {
  display: flex;
  align-items: center;
}

.brand-row {
  margin-bottom: 8rpx;
}

.brand-mark {
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #E8B7C8, #D7A8BE);
  overflow: hidden;
}

.brand-logo {
  width: 34rpx;
  height: 34rpx;
}

.brand-name {
  margin-left: 10rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #D79AB4;
}

.header-main {
  justify-content: space-between;
}

.home-title {
  display: block;
  font-size: 44rpx;
  line-height: 1.25;
  font-weight: 800;
  color: #1F1F24;
}

.home-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #9B9BA8;
}

.notice-dot {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 4rpx 18rpx rgba(31, 31, 36, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
}

.notice-icon {
  color: #E8B7C8;
  font-size: 28rpx;
}

.weather-card {
  margin-top: 20rpx;
  padding: 30rpx 30rpx 26rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #EDD8E4 0%, #E4CDD9 44%, #D9CCBF 100%);
  overflow: hidden;
}

.weather-top {
  justify-content: space-between;
}

.location-icon,
.location-text,
.weather-range,
.weather-stats {
  color: #6B5060;
}

.location-icon {
  margin-right: 8rpx;
  font-size: 22rpx;
}

.location-text {
  font-size: 24rpx;
}

.weather-body {
  display: flex;
  align-items: flex-end;
  margin-top: 6rpx;
}

.weather-temp,
.weather-temp-placeholder {
  font-size: 82rpx;
  line-height: 1;
  font-weight: 800;
  color: #1F1F24;
}

.weather-meta {
  margin-left: 16rpx;
  padding-bottom: 8rpx;
}

.weather-condition {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #3D2E35;
}

.weather-range {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
}

.weather-empty {
  margin-top: 8rpx;
}

.weather-temp-placeholder {
  display: block;
}

.weather-empty-text {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6B5060;
}

.weather-symbol {
  position: relative;
  width: 112rpx;
  height: 112rpx;
}

.sun {
  position: absolute;
  top: 12rpx;
  left: 24rpx;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #F5D567;
}

.cloud {
  position: absolute;
  background: rgba(255, 255, 255, 0.88);
  border-radius: 999rpx;
}

.cloud-a {
  width: 76rpx;
  height: 34rpx;
  left: 18rpx;
  top: 54rpx;
}

.cloud-b {
  width: 54rpx;
  height: 30rpx;
  left: 50rpx;
  top: 46rpx;
}

.weather-stats {
  margin-top: 10rpx;
  font-size: 22rpx;
}

.weather-stats text {
  margin-right: 28rpx;
}

.ai-tip {
  display: flex;
  align-items: flex-start;
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.52);
  color: #3D2E35;
  font-size: 24rpx;
  line-height: 1.55;
}

.spark {
  margin-right: 10rpx;
  color: #C890A8;
  font-weight: 800;
}

.cta-block {
  margin-top: 30rpx;
}

.primary-cta {
  position: relative;
  min-height: 164rpx;
  padding: 34rpx 34rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #E8B7C8 0%, #D9A5BB 100%);
  box-shadow: 0 16rpx 44rpx rgba(232, 183, 200, 0.32);
  display: flex;
  align-items: center;
  justify-content: space-between;
  overflow: hidden;
}

.cta-title {
  display: block;
  font-size: 36rpx;
  line-height: 1.3;
  font-weight: 800;
  color: #1F1F24;
}

.cta-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(31, 31, 36, 0.62);
}

.cta-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.cta-icon {
  width: 58rpx;
  height: 58rpx;
}

.cta-orb {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.13);
}

.orb-a {
  right: -28rpx;
  top: -28rpx;
  width: 148rpx;
  height: 148rpx;
}

.orb-b {
  right: -60rpx;
  bottom: -48rpx;
  width: 180rpx;
  height: 180rpx;
}

.album-cta {
  justify-content: center;
  height: 88rpx;
  margin-top: 20rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(232, 183, 200, 0.55);
  color: #1F1F24;
  font-size: 30rpx;
  font-weight: 600;
}

.album-cta-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
}

.feature-grid {
  display: flex;
  justify-content: space-between;
  margin-top: 38rpx;
}

.feature-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.feature-icon-wrap {
  width: 108rpx;
  height: 108rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.feature-icon-wrap.rose { background: #FBF0F4; }
.feature-icon-wrap.gold { background: #FBF4EC; }
.feature-icon-wrap.sage { background: #EEF5F4; }
.feature-icon-wrap.lavender { background: #F3F0FB; }

.feature-icon {
  width: 46rpx;
  height: 46rpx;
}

.feature-title {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #5A5A67;
  font-weight: 600;
}

.section {
  margin-top: 44rpx;
}

.section-header {
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 800;
  color: #1F1F24;
}

.section-more {
  font-size: 24rpx;
  color: #C890A8;
}

.recent-scroll,
.style-scroll {
  width: 100%;
  white-space: nowrap;
}

.recent-list,
.style-list {
  display: flex;
}

.recent-card {
  width: 224rpx;
  margin-right: 22rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(31, 31, 36, 0.06);
  display: inline-flex;
  flex-direction: column;
}

.recent-image {
  width: 224rpx;
  height: 260rpx;
  background: #F0EDE8;
}

.recent-content {
  padding: 18rpx 20rpx;
}

.recent-title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #1F1F24;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-time {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #9B9BA8;
}

.style-card {
  position: relative;
  width: 216rpx;
  height: 292rpx;
  margin-right: 22rpx;
  border-radius: 32rpx;
  overflow: hidden;
  display: inline-flex;
  background: #F0EDE8;
}

.style-image {
  width: 216rpx;
  height: 292rpx;
}

.style-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 132rpx;
  background: linear-gradient(to top, rgba(31, 31, 36, 0.72), rgba(31, 31, 36, 0));
}

.style-info {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: 18rpx;
}

.style-name {
  display: block;
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 800;
  color: #FFFFFF;
}

.style-count {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.76);
}

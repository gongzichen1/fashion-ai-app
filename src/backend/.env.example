# 环境变量配置文件
# 复制此文件为 .env 并填入实际值

# OpenAI兼容大模型配置（生产必填；未配置时返回明确错误）
AI_API_URL=https://your-provider.example.com/api
AI_API_KEY=your_api_key_here
AI_MODEL=your_model_name_here
AI_TIMEOUT=60

# 服务配置
HOST=0.0.0.0
PORT=5001
DEBUG=False
CORS_ORIGINS=https://your-production-domain.example.com

# 生产必填，使用长随机值
SECRET_KEY=replace-with-a-long-random-secret

# 飞书企业自建应用
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DEV_LOGIN_ENABLED=False
FEISHU_JSAPI_TICKET=

# 微信小程序 code2session
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 非生产演示环境才可开启；默认失败必须显式报错
AI_DEMO_MODE=False

# 本地可使用 SQLite；生产填写托管 MySQL 或 PostgreSQL 连接串
# MySQL: mysql+pymysql://user:password@host:3306/fashion_ai?charset=utf8mb4
# PostgreSQL: postgresql+psycopg://user:password@host:5432/fashion_ai
DATABASE_URL=sqlite:///fashion_ai.db
STORAGE_BACKEND=local
STORAGE_PUBLIC_PREFIX=/uploads
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=
COS_TOKEN=
IMAGE_RETENTION_DAYS=30

# 同源部署时指向 Vite 构建目录；统一 Dockerfile 已预置 /app/web-dist
WEB_DIST_DIR=

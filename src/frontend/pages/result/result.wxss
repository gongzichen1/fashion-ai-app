.result-page {
  min-height: 100vh;
  padding: 20rpx 40rpx 48rpx;
  background: #F8F6F2;
}

.loading-text {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #9B9BA8;
}

.top-bar,
.back-btn,
.card-title-row,
.palette-row,
.section-header,
.scene-list,
.recommend-list,
.suggestion-card,
.action-grid {
  display: flex;
  align-items: center;
}

.top-bar {
  justify-content: space-between;
  height: 72rpx;
}

.back-btn {
  width: 128rpx;
  color: #1F1F24;
  font-size: 30rpx;
}

.back-icon {
  margin-right: 6rpx;
  font-size: 46rpx;
  line-height: 1;
}

.page-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1F1F24;
}

.top-spacer {
  width: 128rpx;
}

.hero-card {
  position: relative;
  height: 520rpx;
  margin-top: 8rpx;
  border-radius: 44rpx;
  overflow: hidden;
  background: #EAE7E2;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.score-badge {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  display: flex;
  align-items: center;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(248, 246, 242, 0.92);
  color: #1F1F24;
  font-size: 24rpx;
  font-weight: 700;
}

.score-star {
  margin-right: 8rpx;
  color: #E8B7C8;
}

.analysis-card,
.color-card {
  margin-top: 28rpx;
  padding: 30rpx;
  border-radius: 36rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 24rpx rgba(31, 31, 36, 0.05);
}

.card-title-row {
  margin-bottom: 24rpx;
}

.card-title-row.compact {
  margin-bottom: 20rpx;
}

.title-mark {
  width: 48rpx;
  height: 48rpx;
  margin-right: 14rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #E8B7C8, #D7A8BE);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 800;
}

.card-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1F1F24;
}

.card-title.small {
  font-size: 28rpx;
}

.attr-grid {
  display: flex;
  flex-wrap: wrap;
}

.attr-item {
  width: 50%;
  margin-bottom: 24rpx;
}

.attr-label {
  display: block;
  margin-bottom: 6rpx;
  font-size: 22rpx;
  color: #9B9BA8;
}

.attr-value {
  display: block;
  max-width: 280rpx;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #1F1F24;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: -4rpx;
}

.style-tag {
  margin: 8rpx 10rpx 0 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #FBF0F4;
  color: #C070A0;
  font-size: 22rpx;
  font-weight: 700;
}

.analysis-desc {
  display: block;
  margin-top: 22rpx;
  font-size: 25rpx;
  line-height: 1.65;
  color: #6B6B78;
}

.palette-icon {
  margin-right: 12rpx;
  color: #D7C3A3;
  font-size: 28rpx;
}

.palette-row {
  justify-content: space-between;
  max-width: 460rpx;
}

.color-dot {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  box-shadow: 0 4rpx 14rpx rgba(31, 31, 36, 0.12);
}

.color-a { background: #F5F0E8; }
.color-b { background: #C4B49A; }
.color-c { background: #8B7355; }
.color-d { background: #3D3028; }

.palette-name {
  display: block;
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #9B9BA8;
}

.scene-section,
.recommend-section {
  margin-top: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1F1F24;
}

.section-count {
  font-size: 24rpx;
  color: #C890A8;
}

.scene-scroll,
.recommend-scroll {
  margin-top: 18rpx;
  white-space: nowrap;
}

.scene-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 62rpx;
  min-width: 110rpx;
  margin-right: 16rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 1rpx solid #E6E7EA;
  color: #6B6B78;
  font-size: 26rpx;
}

.scene-pill.active {
  background: #E8B7C8;
  border-color: #E8B7C8;
  color: #1F1F24;
  font-weight: 800;
}

.recommend-card {
  width: 252rpx;
  margin-right: 22rpx;
  border-radius: 34rpx;
  overflow: hidden;
  background: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(31, 31, 36, 0.06);
  display: inline-flex;
  flex-direction: column;
}

.recommend-image {
  width: 252rpx;
  height: 252rpx;
  background: #F0EDE8;
}

.recommend-content {
  padding: 18rpx;
}

.recommend-type {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  padding: 5rpx 12rpx;
  border-radius: 10rpx;
  background: #FBF0F4;
  color: #C070A0;
  font-size: 18rpx;
  font-weight: 700;
}

.recommend-name {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 800;
  color: #1F1F24;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommend-desc {
  display: block;
  margin-top: 4rpx;
  height: 34rpx;
  font-size: 20rpx;
  color: #9B9BA8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommend-price {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #C890A8;
  font-weight: 800;
}

.empty-recommend {
  margin-top: 18rpx;
  padding: 42rpx 30rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  color: #9B9BA8;
  font-size: 25rpx;
  text-align: center;
}

.suggestion-card {
  align-items: flex-start;
  margin-top: 30rpx;
  padding: 30rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #FBF0F4, #F5EEF8);
}

.suggestion-content {
  flex: 1;
}

.suggestion-title {
  display: block;
  font-size: 26rpx;
  font-weight: 800;
  color: #1F1F24;
}

.suggestion-text {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #3D2E35;
}

.action-grid {
  justify-content: space-between;
  margin-top: 32rpx;
}

.action-item {
  width: 23%;
  height: 128rpx;
  border-radius: 30rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 18rpx rgba(31, 31, 36, 0.05);
  color: #6B6B78;
  font-size: 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.action-item.active {
  color: #D79AB4;
}

.share-btn {
  line-height: 1;
}

.action-icon {
  width: 36rpx;
  height: 36rpx;
  margin-bottom: 12rpx;
}

.home-action {
  height: 88rpx;
  margin-top: 22rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1F1F24;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 800;
}
